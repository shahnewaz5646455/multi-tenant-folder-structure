  "faq": {
    "title": "Pricing questions",
    "entries": {
      "trial": {
        "q": "What happens when the trial ends?",
        "a": "You move to the Free plan automatically. Nothing is deleted; products over the Free limit are hidden until you upgrade."
      },
      "changePlan": {
        "q": "Can I change plans later?",
        "a": "Yes. Upgrades apply immediately with credit for unused days. Downgrades take effect at the end of your billing period."
      },
      "payment": {
        "q": "How do I pay?",
        "a": "bKash, Nagad, Rocket or card. Auto-pay is optional; we send a reminder 3 days before renewal."
      },
      "courier": {
        "q": "Are courier charges included?",
        "a": "No. Courier charges are billed by the courier. We show the cost before you book."
      }
    }
