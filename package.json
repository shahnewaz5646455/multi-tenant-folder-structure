{
  "name": "ecom-manager",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "generate:api": "tsx tooling/scripts/generate-api.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  }
}
